<div class="content-container">
    <h1 class="page-title">Vehicle Management</h1>
    
    <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 15px; margin: 20px 0; border: 1px solid #c3e6cb; border-radius: 4px;">
            <%= messages.success[0] %>
        </div>
    <% } %>
    
    <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 20px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            <%= messages.error[0] %>
        </div>
    <% } %>
    
    <div class="management-options">
        <div class="management-option">
            <a href="/inv/add-classification" class="btn btn-primary">Add New Classification</a>
            <p>Add a new vehicle classification to the database.</p>
        </div>
        
        <div class="management-option">
            <a href="/inv/add-inventory" class="btn btn-primary">Add New Vehicle</a>
            <p>Add a new vehicle to the inventory.</p>
        </div>
    </div>

    <!-- Lista de clasificaciones existentes -->
    <% if (classifications && classifications.length > 0) { %>
        <div class="classifications-list" style="margin-top: 30px;">
            <h2>Current Classifications</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% classifications.forEach(classification => { %>
                        <tr>
                            <td><%= classification.classification_id %></td>
                            <td><%= classification.classification_name %></td>
                            <td>
                                <form method="POST" action="/inv/delete-classification/<%= classification.classification_id %>" 
                                      style="display: inline-block;" 
                                      onsubmit="return confirm('Are you sure you want to delete this classification? This action cannot be undone.');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info" style="margin-top: 20px;">
            No classifications found. Add a new classification using the button above.
        </div>
    <% } %>
</div>
