<div class="content-container">
    <h1 class="page-title">Vehicle Management</h1>
    
    <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 15px; margin: 20px 0; border: 1px solid #c3e6cb; border-radius: 4px;">
            <%= messages.success[0] %>
        </div>
    <% } %>
    
    <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 20px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            <%= messages.error[0] %>
        </div>
    <% } %>
    
    <div class="management-options">
        <div class="management-option">
            <a href="/inv/add-classification" class="btn btn-primary">Add New Classification</a>
            <p>Add a new vehicle classification to the database.</p>
        </div>
        
        <div class="management-option">
            <a href="/inv/add-inventory" class="btn btn-primary">Add New Vehicle</a>
            <p>Add a new vehicle to the inventory.</p>
        </div>
    </div>

    <!-- Lista de vehículos existentes -->
    <div class="vehicles-list" style="margin-top: 40px;">
        <h2 class="mb-4">Current Inventory</h2>
        <% if (vehicles && vehicles.length > 0) { %>
            <div class="table-responsive">
                <table class="vehicles-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Vehicle</th>
                            <th>Year</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% vehicles.forEach(vehicle => { %>
                            <tr>
                                <td data-label="Image">
                                    <img src="<%= vehicle.inv_thumbnail || '/images/vehicles/no-image-tn.png' %>" 
                                         alt="<%= vehicle.inv_make %> <%= vehicle.inv_model %>" 
                                         class="vehicle-image">
                                </td>
                                <td data-label="Vehicle">
                                    <div class="fw-semibold"><%= vehicle.inv_make %> <%= vehicle.inv_model %></div>
                                    <small class="text-muted"><%= vehicle.classification_name %></small>
                                </td>
                                <td data-label="Year"><%= vehicle.inv_year %></td>
                                <td data-label="Price" class="fw-bold text-primary">$<%= new Intl.NumberFormat('en-US').format(vehicle.inv_price) %></td>
                                <td data-label="Actions">
                                    <div class="vehicle-actions">
                                        <a href="/inv/edit/<%= vehicle.inv_id %>" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form method="POST" action="/inv/delete/<%= vehicle.inv_id %>" 
                                              onsubmit="return confirm('Are you sure you want to delete this vehicle? This action cannot be undone.');"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                No se encontraron vehículos. Agrega un nuevo vehículo usando el botón de arriba.
            </div>
        <% } %>
    </div>

    <!-- Classifications Section -->
    <div class="classifications-section" style="margin-top: 3rem;">
        <h2 class="section-title text-center mb-4">Current Classifications</h2>
            <hr class="section-divider mb-4" style="width:120px;border-top:3px solid #f0ad4e;opacity:1;">
        
        <% if (classifications && classifications.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle classifications-table">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% classifications.forEach(classification => { %>
                            <tr>
                                <td class="text-center fw-bold"><%= classification.classification_id %></td>
                                <td class="fw-medium"><%= classification.classification_name %></td>
                                <td class="text-end">
                                    <a href="/inv/edit-classification/<%= classification.classification_id %>" class="btn btn-primary btn-sm me-2" title="Edit Classification">
                                            <i class="bi bi-pencil"></i> Edit
                                         </a>
                                         <form method="POST" 
                                           action="/inv/delete-classification/<%= classification.classification_id %>" 
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this classification? This action cannot be undone.');">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Classification">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                No classifications found. Add a new classification using the button above.
            </div>
        <% } %>
    </div>
</div>
