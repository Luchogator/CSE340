<div class="content-container">
    <div class="form-container">
        <div class="form-header">
            <h1 class="form-title">Add New Classification</h1>
            <p class="form-subtitle">Create a new vehicle classification</p>
        </div>
        
        <% if (messages && messages.error) { %>
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div><%= messages.error %></div>
            </div>
        <% } %>
        
        <% if (messages && messages.success) { %>
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <div><%= messages.success %></div>
            </div>
        <% } %>
        
        <form id="classificationForm" action="/inv/add-classification" method="post" class="needs-validation" novalidate>
            <input type="hidden" name="_method" value="POST">
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            
            <div class="form-group">
                <label for="classification_name" class="form-label">
                    Classification Name <span class="required">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-icon">
                        <i class="bi bi-tag-fill"></i>
                    </span>
                    <input 
                        type="text" 
                        id="classification_name" 
                        name="classification_name" 
                        class="form-control"
                        placeholder="e.g., Sedan, SUV, Truck"
                        required
                        title="Only letters are allowed (no spaces, numbers, or special characters)"
                        pattern="^[A-Za-z]+$"
                        <% if (formData && formData.classification_name) { %>
                            value="<%= formData.classification_name %>"
                        <% } %>
                    >
                </div>
                <div class="form-hint">
                    <i class="bi bi-info-circle"></i>
                    Use letters only (A-Z, a-z). No spaces, numbers, or special characters allowed.
                </div>
                <div class="invalid-feedback">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Please enter a valid classification name (letters only)</span>
                </div>
                <div id="clientError" class="client-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span id="clientErrorText"></span>
                </div>
            </div>
            
            <div class="form-actions">
                <a href="/inv/" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add Classification
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Client-side form validation
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('classificationForm');
    const nameInput = document.getElementById('classification_name');
    const clientErrorDiv = document.getElementById('clientError');
    const serverErrorDiv = document.querySelector('.invalid-feedback');
    let lastValidationMessage = '';
    let isValidationActive = false;
    
    // Hide server error by default, show only when needed
    if (serverErrorDiv) {
        serverErrorDiv.style.display = 'none';
    }
    
    // Real-time validation with debounce
    let timeoutId;
    nameInput.addEventListener('input', function() {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(validateName, 300);
        
        // Hide server error when user starts typing
        if (serverErrorDiv) {
            serverErrorDiv.style.display = 'none';
        }
        
        // Show client error if needed
        validateName();
    });
    
    // Show required tooltip on focus
    nameInput.addEventListener('focus', function() {
        this.title = this.validity.valueMissing ? 
            'Please enter a classification name' : 
            'Enter only letters (no numbers or special characters)';
    });
    
    // Form submission validation
    form.addEventListener('submit', function(event) {
        isValidationActive = true;
        if (!validateName()) {
            event.preventDefault();
            return false;
        }
        return true;
    });
    
    function validateName() {
        const value = nameInput.value.trim();
        const nameRegex = /^[A-Za-z]+$/; // Only letters, no spaces
        
        // Clear previous validation state
        nameInput.setCustomValidity('');
        
        if (!value) {
            if (isValidationActive) {
                showError('⚠️ Classification name is required');
                showServerError(false);
            }
            return false;
        } else if (!nameRegex.test(value)) {
            if (isValidationActive) {
                showError('⚠️ Only letters are allowed (no spaces, numbers, or special characters)');
                showServerError(false);
            }
            return false;
        } else {
            clearError();
            return true;
        }
    }
    
    function showError(message) {
        if (message === lastValidationMessage) return;
        
        clientErrorDiv.textContent = message;
        clientErrorDiv.style.display = 'block';
        lastValidationMessage = message;
    }
    
    function showServerError(show = true) {
        if (serverErrorDiv) {
            serverErrorDiv.style.display = show ? 'block' : 'none';
        }
    }
    
    function clearError() {
        clientErrorDiv.style.display = 'none';
        lastValidationMessage = '';
    }
});

function validateForm() {
    return true; // Siempre retorna true para permitir envío
}
</script>
