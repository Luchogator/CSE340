<style>
/* Estilos para anular cualquier estilo de validación */
#classificationForm input[type="text"],
#classificationForm input[type="text"]:valid,
#classificationForm input[type="text"]:invalid,
#classificationForm input[type="text"]:focus,
#classificationForm .form-control,
#classificationForm .form-control:valid,
#classificationForm .form-control:invalid,
#classificationForm .form-control:focus,
#classificationForm .form-control.is-valid,
#classificationForm .form-control.is-invalid,
#classificationForm .form-control-plain,
#classificationForm .form-control-plain:valid,
#classificationForm .form-control-plain:invalid,
#classificationForm .form-control-plain:focus,
#classificationForm .form-control-plain.is-valid,
#classificationForm .form-control-plain.is-invalid,
#classification_name,
#classification_name:valid,
#classification_name:invalid,
#classification_name:focus,
#classification_name.is-valid,
#classification_name.is-invalid {
    background-image: none !important;
    background-color: #fff !important;
    border: 1px solid #ced4da !important;
    border-radius: 4px !important;
    box-shadow: none !important;
    padding: 0.375rem 0.75rem !important;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out !important;
}

/* Estilo cuando el campo está enfocado */
#classificationForm input[type="text"]:focus,
#classificationForm .form-control:focus,
#classificationForm .form-control-plain:focus,
#classification_name:focus {
    border-color: #80bdff !important;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
    outline: 0 !important;
}

/* Estilos para los mensajes de error */
#clientError {
    display: none;
    color: #dc3545;
    font-size: 0.875em;
    margin-top: 0.25rem;
}

#clientError.show {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

#clientError i {
    font-size: 1em;
}
</style>

<div class="content-container">
    <div class="form-container">
        <div class="form-header">
            <h1 class="form-title">Add New Classification</h1>
            <p class="form-subtitle">Create a new vehicle classification</p>
        </div>
        
        <% if (messages && messages.error) { %>
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div><%= messages.error %></div>
            </div>
        <% } %>
        
        <% if (messages && messages.success) { %>
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <div><%= messages.success %></div>
            </div>
        <% } %>
        
        <form id="classificationForm" action="/inv/add-classification" method="post">
            <input type="hidden" name="_method" value="POST">
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            
            <div class="form-group">
                <label for="classification_name" class="form-label">
                    Classification Name <span class="required">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-icon">
                        <i class="bi bi-tag-fill"></i>
                    </span>
                    <input 
                        type="text" 
                        id="classification_name" 
                        name="classification_name" 
                        class="form-control form-control-plain"
                        placeholder="e.g., Sedan, SUV, Truck"
                        required
                        title="Only letters are allowed (no spaces, numbers, or special characters)"
                        pattern="^[A-Za-z]+$"
                        <% if (formData && formData.classification_name) { %>
                            value="<%= formData.classification_name %>"
                        <% } %>
                    >
                </div>
                <div class="form-hint">
                    <i class="bi bi-info-circle"></i>
                    Use letters only (A-Z, a-z). No spaces, numbers, or special characters allowed.
                </div>

                <div id="clientError" class="client-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span id="clientErrorText"></span>
                </div>
            </div>
            
            <div class="form-actions">
                <a href="/inv/" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add Classification
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Simple client-side validation
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.getElementById('classification_name');
    const clientErrorDiv = document.getElementById('clientError');
    
    // Clear any existing error messages when user starts typing
    nameInput.addEventListener('input', function() {
        clientErrorDiv.style.display = 'none';
    });
});
</script>
