<div class="content-container" style="padding: 2rem 1rem;">
    <div class="form-container">
        <div class="form-header">
            <h1 class="form-title">Add New Vehicle</h1>
            <p class="form-subtitle">Fill in the details below to add a new vehicle to the inventory</p>
            <p class="required-fields-note">* All fields are required</p>
        </div>

        <form id="inventoryForm" action="/inv/add-inventory" method="post" class="inventory-form needs-validation" novalidate>
            <input type="hidden" name="_method" value="POST">
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            
            <!-- Classification -->
            <div class="form-group mb-3">
                <label for="classification_id" class="form-label">Classification:</label>
                <select class="form-select" id="classification_id" name="classification_id" required>
                    <option value="">Select a classification</option>
                    <% if (classifications && classifications.length > 0) { %>
                        <% classifications.forEach(classification => { %>
                            <option value="<%= classification.classification_id %>"
                                <%= (formData && formData.classification_id == classification.classification_id) ? 'selected' : '' %>>
                                <%= classification.classification_name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
                <div class="invalid-feedback">Please select a classification</div>
            </div>

            <!-- Make -->
            <div class="form-group mb-3">
                <label for="inv_make" class="form-label">Make:</label>
                <input type="text" class="form-control" id="inv_make" name="inv_make" 
                    value="<%= formData && formData.inv_make ? formData.inv_make : '' %>" required
                    pattern="[A-Za-z0-9\s]{1,}">
                <div class="invalid-feedback">Please enter a valid make (letters and numbers only)</div>
            </div>

            <!-- Model -->
            <div class="form-group mb-3">
                <label for="inv_model" class="form-label">Model:</label>
                <input type="text" class="form-control" id="inv_model" name="inv_model" 
                    value="<%= formData && formData.inv_model ? formData.inv_model : '' %>" required
                    pattern="[A-Za-z0-9\s]{1,}">
                <div class="invalid-feedback">Please enter a valid model (letters and numbers only)</div>
            </div>

            <!-- Year -->
            <div class="form-group mb-3">
                <label for="inv_year" class="form-label">Year:</label>
                <input type="number" 
                    class="form-control" 
                    id="inv_year" 
                    name="inv_year" 
                    value="<%= formData && formData.inv_year ? formData.inv_year : '' %>" 
                    min="1900" 
                    max="<%= new Date().getFullYear() + 1 %>" 
                    required>
                <div class="form-text">Enter the vehicle's manufacturing year</div>
                <div class="invalid-feedback">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Please enter a valid year (1900-<%= new Date().getFullYear() + 1 %>)</span>
                </div>
            </div>

            <!-- Description -->
            <div class="form-group mb-3">
                <label for="inv_description" class="form-label">Description:</label>
                <textarea 
                    class="form-control" 
                    id="inv_description" 
                    name="inv_description" 
                    rows="4" 
                    required
                    ><%= formData && formData.inv_description ? formData.inv_description : '' %></textarea>
                <div class="form-text">Provide a detailed description of the vehicle</div>
                <div class="invalid-feedback">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Please enter a description</span>
                </div>
            </div>

            <!-- Image -->
            <div class="form-group mb-3">
                <label for="inv_image" class="form-label">Image Path:</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="inv_image" 
                    name="inv_image" 
                    value="<%= formData && formData.inv_image ? formData.inv_image : '' %>" 
                    placeholder="/images/vehicles/no-image.png"
                    required>
                <div class="form-text">Enter the path to the vehicle image (e.g., /images/vehicles/example.png)</div>
                <div class="invalid-feedback">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Please enter a valid image path</span>
                </div>
            </div>

            <!-- Thumbnail -->
            <div class="form-group mb-3">
                <label for="inv_thumbnail" class="form-label">Thumbnail Path:</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="inv_thumbnail" 
                    name="inv_thumbnail" 
                    value="<%= formData && formData.inv_thumbnail ? formData.inv_thumbnail : '' %>" 
                    placeholder="/images/vehicles/no-image-tn.png"
                    required>
                <div class="form-text">Enter the path to the vehicle thumbnail (e.g., /images/vehicles/example-tn.png)</div>
                <div class="invalid-feedback">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Please enter a valid thumbnail path</span>
                </div>
            </div>

            <!-- Price -->
            <div class="form-group">
                <label for="inv_price" class="form-label">Price:</label>
                <div class="price-input-container">
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input 
                            type="number" 
                            class="form-control price-input" 
                            id="inv_price" 
                            name="inv_price"
                            value="<%= formData && formData.inv_price ? formData.inv_price : '' %>" 
                            step="0.01" 
                            min="0" 
                            placeholder="0.00"
                            required
                        >
                    </div>
                    <div class="invalid-feedback">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>Please enter a valid price</span>
                    </div>
                </div>
            </div>

            <!-- Miles -->
            <div class="form-group mb-3">
                <label for="inv_miles" class="form-label">Miles:</label>
                <input type="number" class="form-control" id="inv_miles" name="inv_miles" 
                    value="<%= formData && formData.inv_miles ? formData.inv_miles : '' %>" 
                    min="0" required>
                <div class="invalid-feedback">Please enter a valid mileage (numbers only)</div>
            </div>

            <!-- Color -->
            <div class="form-group mb-4">
                <label for="inv_color" class="form-label">Color:</label>
                <input type="text" class="form-control" id="inv_color" name="inv_color" 
                    value="<%= formData && formData.inv_color ? formData.inv_color : '' %>" required>
                <div class="invalid-feedback">Please enter a color</div>
            </div>
            
            <div class="form-actions">
                <a href="/inv/" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add Vehicle
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Client-side form validation
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('inventoryForm');
    let isFormSubmitted = false;
    
    // Función para validar un campo individual
    function validateField(field) {
        const isValid = field.checkValidity();
        const errorElement = field.nextElementSibling;
        
        if (isFormSubmitted || field.classList.contains('is-valid') || field.classList.contains('is-invalid')) {
            if (isValid) {
                field.classList.remove('is-invalid');
                field.classList.add('is-valid');
                if (errorElement && errorElement.classList.contains('invalid-feedback')) {
                    errorElement.style.display = 'none';
                }
            } else {
                field.classList.remove('is-valid');
                field.classList.add('is-invalid');
                if (errorElement && errorElement.classList.contains('invalid-feedback')) {
                    errorElement.style.display = 'flex';
                }
            }
        }
        
        return isValid;
    }
    
    // Validación en tiempo real solo después de la primera interacción
    const inputs = form.querySelectorAll('input, select, textarea');
    inputs.forEach(input => {
        // Validar al perder el foco
        input.addEventListener('blur', function() {
            if (isFormSubmitted || input.value.trim() !== '') {
                validateField(input);
            }
        });
        
        // Validar al cambiar el valor
        input.addEventListener('input', function() {
            if (isFormSubmitted || input.classList.contains('is-invalid')) {
                validateField(input);
            }
        });
    });
    
    // Validación al enviar el formulario
    form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
            isFormSubmitted = true;
            
            // Encontrar el primer campo inválido
            const firstInvalid = form.querySelector(':invalid');
            if (firstInvalid) {
                // Desplazarse al primer campo inválido
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalid.focus({ preventScroll: true });
                
                // Validar solo el primer campo inválido
                validateField(firstInvalid);
            }
        }
        
        form.classList.add('was-validated');
    }, false);
    
    // Validar al cambiar opciones en select
    const selectElements = form.querySelectorAll('select');
    selectElements.forEach(select => {
        select.addEventListener('change', function() {
            if (isFormSubmitted || select.classList.contains('is-invalid')) {
                validateField(select);
            }
        });
    });
});
</script>
