<div class="content-container" style="padding:2rem 1rem;">
  <div class="form-container">
    <div class="form-header">
      <h1 class="form-title">Edit Vehicle</h1>
      <p class="required-fields-note">* All fields are required</p>
    </div>
    <form id="inventoryForm" action="/inv/update/<%= vehicle.inv_id %>" method="post" class="inventory-form needs-validation" novalidate>
      <!-- Classification -->
      <div class="form-group mb-3">
        <label for="classification_id" class="form-label">Classification:</label>
        <select class="form-select" id="classification_id" name="classification_id" required>
          <option value="">Select a classification</option>
          <% classifications.forEach(c => { %>
            <option value="<%= c.classification_id %>" <%= vehicle.classification_id === c.classification_id ? 'selected' : '' %>><%= c.classification_name %></option>
          <% }) %>
        </select>
      </div>
      <!-- Make -->
      <div class="form-group mb-3">
        <label for="inv_make" class="form-label">Make:</label>
        <input type="text" class="form-control" id="inv_make" name="inv_make" value="<%= vehicle.inv_make %>" required>
      </div>
      <!-- Model -->
      <div class="form-group mb-3">
        <label for="inv_model" class="form-label">Model:</label>
        <input type="text" class="form-control" id="inv_model" name="inv_model" value="<%= vehicle.inv_model %>" required>
      </div>
      <!-- Year -->
      <div class="form-group mb-3">
        <label for="inv_year" class="form-label">Year:</label>
        <input type="number" class="form-control" id="inv_year" name="inv_year" value="<%= vehicle.inv_year %>" min="1900" max="<%= new Date().getFullYear()+1 %>" required>
      </div>
      <!-- Description -->
      <div class="form-group mb-3">
        <label for="inv_description" class="form-label">Description:</label>
        <textarea class="form-control" id="inv_description" name="inv_description" rows="4" required><%= vehicle.inv_description %></textarea>
      </div>
      <!-- Image -->
      <div class="form-group mb-3">
        <label for="inv_image" class="form-label">Image Path:</label>
        <input type="text" class="form-control" id="inv_image" name="inv_image" value="<%= vehicle.inv_image %>" required>
      </div>
      <!-- Thumbnail -->
      <div class="form-group mb-3">
        <label for="inv_thumbnail" class="form-label">Thumbnail Path:</label>
        <input type="text" class="form-control" id="inv_thumbnail" name="inv_thumbnail" value="<%= vehicle.inv_thumbnail %>" required>
      </div>
      <!-- Price -->
      <div class="form-group mb-3">
        <label for="inv_price" class="form-label">Price:</label>
        <input type="number" step="0.01" class="form-control" id="inv_price" name="inv_price" value="<%= vehicle.inv_price %>" required>
      </div>
      <!-- Miles -->
      <div class="form-group mb-3">
        <label for="inv_miles" class="form-label">Miles:</label>
        <input type="number" class="form-control" id="inv_miles" name="inv_miles" value="<%= vehicle.inv_miles %>" required>
      </div>
      <!-- Color -->
      <div class="form-group mb-4">
        <label for="inv_color" class="form-label">Color:</label>
        <input type="text" class="form-control" id="inv_color" name="inv_color" value="<%= vehicle.inv_color %>" required>
      </div>
      <div class="form-actions">
        <a href="/inv/" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Update Vehicle</button>
      </div>
    </form>
  </div>
</div>
