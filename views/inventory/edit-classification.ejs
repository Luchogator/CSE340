<link rel="stylesheet" href="/css/classification-form.css">
<div class="content-container" style="padding:2rem 1rem;">
  <div class="form-container">
    <div class="form-header text-center">
      <h1 class="form-title">Edit Classification</h1>
      <p class="required-fields-note">* All fields are required</p>
    </div>

    <% if (messages && messages.error) { %>
      <div class="alert alert-danger d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div><%= messages.error %></div>
      </div>
    <% } %>
    <% if (messages && messages.success) { %>
      <div class="alert alert-success d-flex align-items-center">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div><%= messages.success %></div>
      </div>
    <% } %>

    <form id="classificationForm" action="/inv/update-classification/<%= classification.classification_id %>" method="post" class="needs-validation" novalidate>
      <div class="form-group mb-3">
        <label for="classification_name" class="form-label">Classification Name:</label>
        <div class="input-group">
          <span class="input-group-icon"><i class="bi bi-tag-fill"></i></span>
          <input type="text" class="form-control form-control-plain" id="classification_name" name="classification_name" value="<%= classification.classification_name %>" required pattern="^[A-Za-z]+$" title="Only letters are allowed (no spaces, numbers, or special characters)">
        </div>
        <div id="clientError" class="client-error">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span id="clientErrorText"></span>
        </div>
      </div>
      <div class="form-actions">
        <a href="/inv/" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Update Classification</button>
      </div>
    </form>
  </div>
</div>
